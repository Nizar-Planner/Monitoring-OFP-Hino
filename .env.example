# Port running the application (Render/Vite will set this automatically)
PORT=3000
NODE_ENV=production

# Supabase Database & Storage Configuration
# Dapatkan Project URL dan API Key dari dashboard Supabase -> Project Settings -> API
VITE_SUPABASE_URL="https://sztgjyrgcmrypvkratty.supabase.co"
VITE_SUPABASE_ANON_KEY="sb_publishable_6Pg9jjmCNm2Uo_4FD1i8qQ_5aOqVsP7"
# Service Role Key untuk operasi server-side admin / bypass RLS (opsional)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InN6dGdqeXJnY21yeXB2a3JhdHR5Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc5MjUwNzEyMSwiZXhwIjoyMTA4MDgzMTIxfQ.sTq-nOd2gta20nEFq90846o4KRwq1ZEAZ7NxKKnWZFI"

# Supabase Storage Bucket name untuk bukti foto part failure (default: opf-attachments)
SUPABASE_STORAGE_BUCKET="opf-attachments"

# Kredensial Akun HIS (Hino Information System)
# Wajib diisi agar robot scraper dapat login dan menarik data OPF/DTR
HIS_USER="dealer_teknik_01"
HIS_PASSWORD="your_secure_password"

# URL Portal HIS (Bisa disesuaikan dengan URL resmi portal HIS Hino Anda)
HIS_URL="https://his.hino.co.id/portal"

# Interval penarikan data otomatis oleh Robot (dalam jam, default: 3 jam)
SYNC_INTERVAL_HOURS=3

# Lokasi Chromium / Chrome di server Linux / Render (disediakan oleh Dockerfile)
PUPPETEER_EXECUTABLE_PATH="/usr/bin/chromium"

# Gemini API Key (opsional)
GEMINI_API_KEY=""
APP_URL="http://localhost:3000"
